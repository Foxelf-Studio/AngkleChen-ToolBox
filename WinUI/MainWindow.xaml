<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AngkleChen.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AngkleChen"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="Nav"
                        Grid.Row="0"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        OpenPaneLength="200"
                        Background="Transparent"
                        SelectionChanged="OnCategoryChanged">

            <NavigationView.PaneHeader>
                <TextBlock Text="陈叔叔工具箱"
                           Margin="4,0,0,12"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           FontFamily="Microsoft YaHei"
                           FontSize="16"
                           FontWeight="SemiBold" />
            </NavigationView.PaneHeader>

            <NavigationView.Content>
                <Grid>
                    <!-- ── 工具列表 ─────────────────────── -->
                    <Grid x:Name="ToolsView" Padding="20,12,20,0" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="2">
                            <TextBlock x:Name="HeaderTitle"
                                       Text="全部工具"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       FontFamily="Microsoft YaHei"
                                       FontSize="22"
                                       FontWeight="Bold" />
                            <TextBlock x:Name="HeaderSubtitle"
                                       Text=""
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       FontFamily="Microsoft YaHei"
                                       FontSize="12" />
                        </StackPanel>

                        <TextBox x:Name="SearchBox"
                                 Grid.Row="1"
                                 Height="40"
                                 PlaceholderText="搜索工具名称、描述或分类…"
                                 FontFamily="Microsoft YaHei"
                                 FontSize="14"
                                 TextChanged="OnSearchChanged" />

                        <GridView x:Name="ToolGrid"
                                  Grid.Row="2"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="OnToolClick">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:ToolCardVm">
                                    <!--
                                        选中/悬停不走 GridViewItem 的默认视觉（系统蓝框 + 对勾），
                                        改成原版的三层叠色：底色 → 选中色 → 悬停色。
                                        每层都用 ThemeResource，切主题时自动跟随。
                                    -->
                                    <Grid Width="200"
                                          Height="92"
                                          Margin="0,0,12,12"
                                          Background="Transparent">

                                        <Border CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundBrush}"
                                                BorderBrush="{ThemeResource CardBorderBrush}"
                                                BorderThickness="1" />

                                        <Border CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundSelectedBrush}"
                                                BorderBrush="{ThemeResource CardBorderSelectedBrush}"
                                                BorderThickness="1"
                                                Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />

                                        <Grid Padding="14,12" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="36"
                                                    Height="36"
                                                    CornerRadius="18"
                                                    Background="{ThemeResource CardBackgroundHoverBrush}">
                                                <FontIcon Glyph="&#xE90F;"
                                                          FontSize="16"
                                                          Foreground="{ThemeResource TextSecondaryBrush}" />
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                <TextBlock Text="{x:Bind Name}"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           FontFamily="Microsoft YaHei"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Category}"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           FontFamily="Microsoft YaHei"
                                                           FontSize="11"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- 最上层只负责悬停高亮，命中测试照常，点击会冒泡到 GridViewItem -->
                                        <Border x:Name="HoverLayer"
                                                CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundHoverBrush}"
                                                Opacity="0"
                                                PointerEntered="OnCardPointerEntered"
                                                PointerExited="OnCardPointerExited" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>

                    <!-- ── 设置页（P2 填充：更新检查 / 日志开关 / 回收站）── -->
                    <Grid x:Name="SettingsView"
                          Padding="20,12,20,0"
                          Visibility="Collapsed"
                          RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="2">
                            <TextBlock Text="设置"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       FontFamily="Microsoft YaHei"
                                       FontSize="22"
                                       FontWeight="Bold" />
                            <TextBlock Text="更新检查、日志开关、回收站"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       FontFamily="Microsoft YaHei"
                                       FontSize="12" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                VerticalAlignment="Top"
                                Padding="20"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="设置页骨架"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontFamily="Microsoft YaHei"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="P2 会把现有的更新开关、日志开关、回收站入口搬到这里。"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           FontFamily="Microsoft YaHei"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>

        <Border Grid.Row="1"
                Padding="20,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardBorderBrush}">
            <Grid>
                <TextBlock x:Name="StatusText"
                           Text="正在加载…"
                           Foreground="{ThemeResource TextTertiaryBrush}"
                           FontFamily="Microsoft YaHei"
                           FontSize="11" />
                <TextBlock x:Name="StatusTip"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextTertiaryBrush}"
                           FontFamily="Microsoft YaHei"
                           FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
