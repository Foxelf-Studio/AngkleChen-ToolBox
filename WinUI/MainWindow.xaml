<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AngkleChen.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AngkleChen"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="Nav"
                        Grid.Row="0"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        OpenPaneLength="200"
                        Background="Transparent"
                        SelectionChanged="OnCategoryChanged">

            

            <NavigationView.Content>
                <Grid>
                    <!-- ── 工具列表 ─────────────────────── -->
                    <Grid x:Name="ToolsView" Padding="20,12,20,0" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:Name="HeaderTitle"
                                           Text="全部工具"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           FontFamily="Microsoft YaHei"
                                           FontSize="22"
                                           FontWeight="Bold" />
                                <TextBlock x:Name="HeaderSubtitle"
                                           Text=""
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           FontFamily="Microsoft YaHei"
                                           FontSize="12" />
                            </StackPanel>

                            <Button x:Name="BtnAddTool"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="OnAddTool">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="添加工具" FontFamily="Microsoft YaHei" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!--
                            自绘搜索框：外层 Border 定高 40，里面放一个无边框的 TextBox。
                            WinUI 的 TextBox 内容顶部对齐，高度一旦大于内容就必然偏上，
                            Padding / VerticalContentAlignment / TextControlThemePadding 都改不动，
                            所以高度交给外层容器，TextBox 只负责输入。
                        -->
                        <Border x:Name="SearchBorder"
                                Grid.Row="1"
                                Height="40"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                            <Grid ColumnSpacing="8" Padding="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE721;"
                                          FontSize="14"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextTertiaryBrush}" />

                                <!--
                                    TextBox 的内容永远顶部对齐：高度比内容多出来的部分全堆在下面。
                                    这里把高度压到只够一行（18），再靠容器居中，
                                    顺便把它自己的聚焦下划线刷成透明，描边交给外层 Border。
                                -->
                                <TextBox x:Name="SearchBox"
                                         Grid.Column="1"
                                         Height="18"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         MinHeight="0"
                                         Padding="0"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         UseSystemFocusVisuals="False"
                                         FocusVisualPrimaryThickness="0"
                                         FocusVisualSecondaryThickness="0"
                                         PlaceholderText="搜索工具名称、描述或分类…"
                                         FontFamily="Microsoft YaHei"
                                         FontSize="14"
                                         TextChanged="OnSearchChanged"
                                         GotFocus="OnSearchGotFocus"
                                         LostFocus="OnSearchLostFocus">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                        <!-- 悬停态也会画一圈内框，同样要压掉 -->
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    </TextBox.Resources>
                                </TextBox>
                            </Grid>

                            <!--
                                聚焦框画在外层：TextBox 自己那圈只有 18px 高，
                                和外层 40px 的搜索框差一半，看起来像没对齐。
                            -->
                            <Border x:Name="SearchFocusRing"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource AccentColorBrush}"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!-- 配置损坏/缺失时的红条，和 WPF 版一致 -->
                        <Border x:Name="WarningBar"
                                Grid.Row="2"
                                Visibility="Collapsed"
                                Padding="14,10"
                                CornerRadius="8"
                                Background="{ThemeResource WarningBackgroundBrush}"
                                BorderBrush="{ThemeResource WarningBorderBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE7BA;"
                                          FontSize="15"
                                          VerticalAlignment="Top"
                                          Foreground="{ThemeResource WarningIconBrush}" />

                                <TextBlock x:Name="WarningText"
                                           Grid.Column="1"
                                           Foreground="{ThemeResource WarningTextBrush}"
                                           FontFamily="Microsoft YaHei"
                                           FontSize="12.5"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <GridView x:Name="ToolGrid"
                                  Grid.Row="3"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  UseSystemFocusVisuals="False"
                                  ItemClick="OnToolClick"
                                  CanDragItems="True"
                                  CanReorderItems="True"
                                  AllowDrop="True"
                                  DragItemsStarting="OnDragItemsStarting"
                                  DragItemsCompleted="OnDragItemsCompleted">

                            <!--
                                GridViewItem 的 PointerOver / Pressed 状态应用的是
                                SystemControlHighlightListLow/MediumBrush（老 UWP 键），
                                不是 GridViewItemBackgroundPointerOver。
                                这层底色按「条目矩形」绘制（含卡片外 12px margin）且是直角，
                                表现为光标还没进卡片就先亮一块方角矩形。
                                只在本 GridView 内覆盖，避免影响按钮等其它控件的悬停。
                            -->
                            <GridView.Resources>
                                <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="Transparent" />
                            </GridView.Resources>

                            <!--
                                再把容器模板整个换掉。
                                只覆盖画刷还不够——GridViewItem 的模板里仍有别处会绘制矩形，
                                表现为高光溢出卡片圆角、甚至偏移一块。
                                这里只留一个没有任何背景的 ContentPresenter：
                                悬停、选中、按下全部由卡片自己的那层负责，容器不参与绘制。
                            -->
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <!-- 容器不画任何聚焦框：白框会套在卡片外面，比卡片大一圈 -->
                                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                                    <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                                    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GridViewItem">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Stretch"
                                                                  Background="Transparent" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GridView.ItemContainerStyle>                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:ToolCardVm">
                                    <!-- 左上不留边、右下落 10：左边缘与下方描述栏对齐，
                                         格距仍是 205+10=215 × 140+10=150，与 WPF 版一致 -->
                                    <local:CardRoot Width="205"
                                          Height="140"
                                          Margin="0,0,10,10"
                                          Background="Transparent"
                                          Opacity="{x:Bind CardOpacity, Mode=OneWay}"
                                          DoubleTapped="OnCardDoubleTapped"
                                          PointerEntered="OnCardPointerEntered"
                                          PointerExited="OnCardPointerExited">

                                        <Grid.ContextFlyout>
                                            <MenuFlyout Opening="OnCardMenuOpening" Closed="OnCardMenuClosed">
                                                <MenuFlyoutItem Text="启动" Click="OnMenuLaunch">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE768;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="编辑名称与描述" Click="OnMenuEdit">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE70F;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="移入回收站" Click="OnMenuDelete">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>

                                        <Border CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundBrush}"
                                                BorderBrush="{ThemeResource CardBorderBrush}"
                                                BorderThickness="1" />

                                        <!-- 悬停层必须在内容下面：放在上面会整块盖住图标和文字 -->
                                        <!-- 内缩 1px：高光盖上来时不至于把卡片描边吃掉 -->
                                        <Border CornerRadius="7"
                                                Margin="1"
                                                Tag="hover"
                                                Background="{ThemeResource CardBackgroundHoverBrush}"
                                                Opacity="0" />

                                        <Border CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundSelectedBrush}"
                                                BorderBrush="{ThemeResource CardBorderSelectedBrush}"
                                                BorderThickness="1"
                                                Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />

                                        <!-- 版式照 WPF 版 ToolCard：图标居中在上、名称在下，整体垂直居中 -->
                                        <Grid Margin="8,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    Width="48"
                                                    Height="48"
                                                    CornerRadius="24"
                                                    Background="{ThemeResource CardBackgroundHoverBrush}">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE90F;"
                                                              FontSize="20"
                                                              Foreground="{ThemeResource TextTertiaryBrush}" />
                                                    <Image Width="44"
                                                           Height="44"
                                                           Stretch="Uniform"
                                                           Source="{x:Bind Icon, Mode=OneWay}" />
                                                </Grid>
                                            </Border>

                                            <TextBlock Grid.Row="1"
                                                       Margin="0,8,0,0"
                                                       Text="{x:Bind Name}"
                                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                                       FontFamily="Microsoft YaHei"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </local:CardRoot>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <TextBlock x:Name="EmptyHint"
                                   Grid.Row="3"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="13"
                                   Text="没有找到匹配的工具，换个关键词试试" />

                        <!-- ── 详情栏 ─────────────────────── -->
                        <Border Grid.Row="4"
                                Margin="0,0,0,12"
                                Padding="16,12"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <!-- 选中工具 -->
                                <Grid x:Name="DetailPanel" Visibility="Collapsed" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Image x:Name="DetailIcon"
                                           Grid.Column="0"
                                           Width="40"
                                           Height="40"
                                           Stretch="Uniform" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="DetailName"
                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="16"
                                                   FontWeight="Bold" />
                                        <TextBlock x:Name="DetailCategory"
                                                   Foreground="{ThemeResource AccentColorBrush}"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="11" />
                                    </StackPanel>

                                    <TextBlock x:Name="DetailDescription"
                                               Grid.Column="2"
                                               Margin="16,0,16,0"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               FontFamily="Microsoft YaHei"
                                               FontSize="12.5"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="3"
                                               Text="双击启动"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextTertiaryBrush}"
                                               FontFamily="Microsoft YaHei"
                                               FontSize="11" />
                                </Grid>

                                <!-- 未选中 -->
                                <Grid x:Name="DetailPlaceholder" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            CornerRadius="20"
                                            Background="{ThemeResource CardBackgroundHoverBrush}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="选择一个工具"
                                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="单击卡片查看详情，双击直接启动"
                                                   Foreground="{ThemeResource TextHintBrush}"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ── 设置页（P2 填充）─────────────── -->
                    <Grid x:Name="SettingsView"
                          Padding="20,12,20,0"
                          Visibility="Collapsed"
                          RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="2">
                            <TextBlock Text="设置"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       FontFamily="Microsoft YaHei"
                                       FontSize="22"
                                       FontWeight="Bold" />
                            <TextBlock Text="更新检查、日志开关、回收站"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       FontFamily="Microsoft YaHei"
                                       FontSize="12" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1">
                            <StackPanel Spacing="12">
                                <!-- 常规 -->
                                <Border Padding="20"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="常规"
                                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock Text="自动检查更新"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           FontFamily="Microsoft YaHei"
                                                           FontSize="13" />
                                                <TextBlock Text="启动后访问 GitHub Release 检查新版本"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           FontFamily="Microsoft YaHei"
                                                           FontSize="11" />
                                            </StackPanel>

                                            <ToggleSwitch x:Name="ToggleAutoCheck"
                                                          Grid.Column="1"
                                                          MinWidth="0"
                                                          Toggled="OnSettingsToggled" />
                                        </Grid>

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock Text="记录调试日志"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           FontFamily="Microsoft YaHei"
                                                           FontSize="13" />
                                                <TextBlock Text="在程序目录写 debug.log，排查问题时再开"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           FontFamily="Microsoft YaHei"
                                                           FontSize="11" />
                                            </StackPanel>

                                            <ToggleSwitch x:Name="ToggleLog"
                                                          Grid.Column="1"
                                                          MinWidth="0"
                                                          Toggled="OnSettingsToggled" />
                                        </Grid>

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock Text="外观主题"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           FontFamily="Microsoft YaHei"
                                                           FontSize="13" />
                                                <TextBlock Text="跟随系统时会随 Windows 的浅色/深色设置变化"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           FontFamily="Microsoft YaHei"
                                                           FontSize="11" />
                                            </StackPanel>

                                            <ComboBox x:Name="ThemeBox"
                                                      Grid.Column="1"
                                                      MinWidth="132"
                                                      SelectionChanged="OnThemeChanged">
                                                <ComboBoxItem Content="跟随系统" Tag="system" />
                                                <ComboBoxItem Content="浅色" Tag="light" />
                                                <ComboBoxItem Content="深色" Tag="dark" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 回收站 -->
                                <Border Padding="20"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <Grid>
                                            <TextBlock Text="回收站"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                                       FontFamily="Microsoft YaHei"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />

                                            <Button x:Name="BtnEmptyTrash"
                                                    HorizontalAlignment="Right"
                                                    Padding="10,4"
                                                    Content="清空回收站"
                                                    FontFamily="Microsoft YaHei"
                                                    FontSize="12"
                                                    Click="OnEmptyTrash" />
                                        </Grid>

                                        <TextBlock x:Name="TrashEmptyHint"
                                                   Text="回收站是空的"
                                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="12" />

                                        <ItemsControl x:Name="TrashList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:TrashItemVm">
                                                    <Grid Padding="0,7" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="{x:Bind Name}"
                                                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                                                       FontFamily="Microsoft YaHei"
                                                                       FontSize="12.5"
                                                                       MaxLines="1"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Subtitle}"
                                                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                                                       FontFamily="Microsoft YaHei"
                                                                       FontSize="11"
                                                                       MaxLines="1"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <Button Grid.Column="1"
                                                                Padding="10,2"
                                                                Content="恢复"
                                                                FontFamily="Microsoft YaHei"
                                                                FontSize="12"
                                                                Tag="{x:Bind Id}"
                                                                Click="OnRestoreTrash" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>

        <Border Grid.Row="1"
                Padding="20,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardBorderBrush}">
            <Grid>
                <TextBlock x:Name="StatusText"
                           Text="正在加载…"
                           Foreground="{ThemeResource TextTertiaryBrush}"
                           FontFamily="Microsoft YaHei"
                           FontSize="11" />
                <TextBlock x:Name="StatusTip"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextTertiaryBrush}"
                           FontFamily="Microsoft YaHei"
                           FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
