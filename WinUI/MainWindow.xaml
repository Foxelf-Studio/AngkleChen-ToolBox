<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AngkleChen.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AngkleChen"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="Nav"
                        Grid.Row="0"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        OpenPaneLength="200"
                        Background="Transparent"
                        SelectionChanged="OnCategoryChanged">

            <NavigationView.PaneHeader>
                <TextBlock Text="陈叔叔工具箱"
                           Margin="4,0,0,12"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           FontFamily="Microsoft YaHei"
                           FontSize="16"
                           FontWeight="SemiBold" />
            </NavigationView.PaneHeader>

            <NavigationView.Content>
                <Grid Padding="20,12,20,0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题区：分类名 + 计数 -->
                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock x:Name="HeaderTitle"
                                   Text="全部工具"
                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="22"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="HeaderSubtitle"
                                   Text=""
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="12" />
                    </StackPanel>

                    <!-- 搜索框 -->
                    <TextBox x:Name="SearchBox"
                             Grid.Row="1"
                             Height="40"
                             PlaceholderText="搜索工具名称、描述或分类…"
                             FontFamily="Microsoft YaHei"
                             FontSize="14"
                             TextChanged="OnSearchChanged" />

                    <!-- 卡片网格 -->
                    <GridView x:Name="ToolGrid"
                              Grid.Row="2"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="OnToolClick">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:ToolCardVm">
                                <Border Width="200"
                                        Height="92"
                                        Margin="0,0,12,12"
                                        Padding="14,12"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="36"
                                                Height="36"
                                                CornerRadius="18"
                                                Background="{ThemeResource CardBackgroundHoverBrush}">
                                            <FontIcon Glyph="&#xE90F;"
                                                      FontSize="16"
                                                      Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="2">
                                            <TextBlock Text="{x:Bind Name}"
                                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                                       FontFamily="Microsoft YaHei"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Category}"
                                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                                       FontFamily="Microsoft YaHei"
                                                       FontSize="11"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </NavigationView.Content>
        </NavigationView>

        <!-- 状态栏 -->
        <Border Grid.Row="1"
                Padding="20,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardBorderBrush}">
            <Grid>
                <TextBlock x:Name="StatusText"
                           Text="正在加载…"
                           Foreground="{ThemeResource TextTertiaryBrush}"
                           FontFamily="Microsoft YaHei"
                           FontSize="11" />
                <TextBlock x:Name="StatusTip"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextTertiaryBrush}"
                           FontFamily="Microsoft YaHei"
                           FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
