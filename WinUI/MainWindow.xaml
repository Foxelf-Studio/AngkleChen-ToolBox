<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AngkleChen.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AngkleChen"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="Nav"
                        Grid.Row="0"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        OpenPaneLength="200"
                        Background="Transparent"
                        SelectionChanged="OnCategoryChanged">

            <NavigationView.PaneHeader>
                <TextBlock Text="陈叔叔工具箱"
                           Margin="4,0,0,12"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           FontFamily="Microsoft YaHei"
                           FontSize="16"
                           FontWeight="SemiBold" />
            </NavigationView.PaneHeader>

            <NavigationView.Content>
                <Grid>
                    <!-- ── 工具列表 ─────────────────────── -->
                    <Grid x:Name="ToolsView" Padding="20,12,20,0" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="2">
                            <TextBlock x:Name="HeaderTitle"
                                       Text="全部工具"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       FontFamily="Microsoft YaHei"
                                       FontSize="22"
                                       FontWeight="Bold" />
                            <TextBlock x:Name="HeaderSubtitle"
                                       Text=""
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       FontFamily="Microsoft YaHei"
                                       FontSize="12" />
                        </StackPanel>

                        <TextBox x:Name="SearchBox"
                                 Grid.Row="1"
                                 Height="40"
                                 PlaceholderText="搜索工具名称、描述或分类…"
                                 FontFamily="Microsoft YaHei"
                                 FontSize="14"
                                 TextChanged="OnSearchChanged" />

                        <!-- 配置损坏/缺失时的红条，和 WPF 版一致 -->
                        <Border x:Name="WarningBar"
                                Grid.Row="2"
                                Visibility="Collapsed"
                                Padding="14,10"
                                CornerRadius="8"
                                Background="{ThemeResource WarningBackgroundBrush}"
                                BorderBrush="{ThemeResource WarningBorderBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE7BA;"
                                          FontSize="15"
                                          VerticalAlignment="Top"
                                          Foreground="{ThemeResource WarningIconBrush}" />

                                <TextBlock x:Name="WarningText"
                                           Grid.Column="1"
                                           Foreground="{ThemeResource WarningTextBrush}"
                                           FontFamily="Microsoft YaHei"
                                           FontSize="12.5"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <GridView x:Name="ToolGrid"
                                  Grid.Row="3"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="OnToolClick">                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:ToolCardVm">
                                    <Grid Width="200"
                                          Height="92"
                                          Margin="0,0,12,12"
                                          Background="Transparent"
                                          DoubleTapped="OnCardDoubleTapped">

                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="启动" Click="OnMenuLaunch">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE768;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="编辑名称与描述" Click="OnMenuEdit">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE70F;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="移入回收站" Click="OnMenuDelete">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>

                                        <Border CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundBrush}"
                                                BorderBrush="{ThemeResource CardBorderBrush}"
                                                BorderThickness="1" />

                                        <Border CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundSelectedBrush}"
                                                BorderBrush="{ThemeResource CardBorderSelectedBrush}"
                                                BorderThickness="1"
                                                Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />

                                        <Grid Padding="14,12" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="36"
                                                    Height="36"
                                                    CornerRadius="18"
                                                    Background="{ThemeResource CardBackgroundHoverBrush}">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE90F;"
                                                              FontSize="16"
                                                              Foreground="{ThemeResource TextTertiaryBrush}" />
                                                    <Image Width="32"
                                                           Height="32"
                                                           Stretch="Uniform"
                                                           Source="{x:Bind Icon, Mode=OneWay}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                <TextBlock Text="{x:Bind Name}"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           FontFamily="Microsoft YaHei"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Category}"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           FontFamily="Microsoft YaHei"
                                                           FontSize="11"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>

                                        <Border CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundHoverBrush}"
                                                Opacity="0"
                                                PointerEntered="OnCardPointerEntered"
                                                PointerExited="OnCardPointerExited" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <TextBlock x:Name="EmptyHint"
                                   Grid.Row="3"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="13"
                                   Text="没有找到匹配的工具，换个关键词试试" />

                        <!-- ── 详情栏 ─────────────────────── -->
                        <Border Grid.Row="4"
                                Margin="0,0,0,12"
                                Padding="16,12"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <!-- 选中工具 -->
                                <Grid x:Name="DetailPanel" Visibility="Collapsed" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Image x:Name="DetailIcon"
                                           Grid.Column="0"
                                           Width="40"
                                           Height="40"
                                           Stretch="Uniform" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="DetailName"
                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="16"
                                                   FontWeight="Bold" />
                                        <TextBlock x:Name="DetailCategory"
                                                   Foreground="{ThemeResource AccentColorBrush}"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="11" />
                                    </StackPanel>

                                    <TextBlock x:Name="DetailDescription"
                                               Grid.Column="2"
                                               Margin="16,0,16,0"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               FontFamily="Microsoft YaHei"
                                               FontSize="12.5"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="3"
                                               Text="双击启动"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextTertiaryBrush}"
                                               FontFamily="Microsoft YaHei"
                                               FontSize="11" />
                                </Grid>

                                <!-- 未选中 -->
                                <Grid x:Name="DetailPlaceholder" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            CornerRadius="20"
                                            Background="{ThemeResource CardBackgroundHoverBrush}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="选择一个工具"
                                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="单击卡片查看详情，双击直接启动"
                                                   Foreground="{ThemeResource TextHintBrush}"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ── 设置页（P2 填充）─────────────── -->
                    <Grid x:Name="SettingsView"
                          Padding="20,12,20,0"
                          Visibility="Collapsed"
                          RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="2">
                            <TextBlock Text="设置"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       FontFamily="Microsoft YaHei"
                                       FontSize="22"
                                       FontWeight="Bold" />
                            <TextBlock Text="更新检查、日志开关、回收站"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       FontFamily="Microsoft YaHei"
                                       FontSize="12" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1">
                            <StackPanel Spacing="12">
                                <!-- 常规 -->
                                <Border Padding="20"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="常规"
                                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock Text="自动检查更新"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           FontFamily="Microsoft YaHei"
                                                           FontSize="13" />
                                                <TextBlock Text="启动后访问 GitHub Release 检查新版本"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           FontFamily="Microsoft YaHei"
                                                           FontSize="11" />
                                            </StackPanel>

                                            <ToggleSwitch x:Name="ToggleAutoCheck"
                                                          Grid.Column="1"
                                                          MinWidth="0"
                                                          Toggled="OnSettingsToggled" />
                                        </Grid>

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock Text="记录调试日志"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           FontFamily="Microsoft YaHei"
                                                           FontSize="13" />
                                                <TextBlock Text="在程序目录写 debug.log，排查问题时再开"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           FontFamily="Microsoft YaHei"
                                                           FontSize="11" />
                                            </StackPanel>

                                            <ToggleSwitch x:Name="ToggleLog"
                                                          Grid.Column="1"
                                                          MinWidth="0"
                                                          Toggled="OnSettingsToggled" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 回收站 -->
                                <Border Padding="20"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <Grid>
                                            <TextBlock Text="回收站"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                                       FontFamily="Microsoft YaHei"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />

                                            <Button x:Name="BtnEmptyTrash"
                                                    HorizontalAlignment="Right"
                                                    Padding="10,4"
                                                    Content="清空回收站"
                                                    FontFamily="Microsoft YaHei"
                                                    FontSize="12"
                                                    Click="OnEmptyTrash" />
                                        </Grid>

                                        <TextBlock x:Name="TrashEmptyHint"
                                                   Text="回收站是空的"
                                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="12" />

                                        <ItemsControl x:Name="TrashList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:TrashItemVm">
                                                    <Grid Padding="0,7" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="{x:Bind Name}"
                                                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                                                       FontFamily="Microsoft YaHei"
                                                                       FontSize="12.5"
                                                                       MaxLines="1"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Subtitle}"
                                                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                                                       FontFamily="Microsoft YaHei"
                                                                       FontSize="11"
                                                                       MaxLines="1"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <Button Grid.Column="1"
                                                                Padding="10,2"
                                                                Content="恢复"
                                                                FontFamily="Microsoft YaHei"
                                                                FontSize="12"
                                                                Tag="{x:Bind Id}"
                                                                Click="OnRestoreTrash" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>

        <Border Grid.Row="1"
                Padding="20,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardBorderBrush}">
            <Grid>
                <TextBlock x:Name="StatusText"
                           Text="正在加载…"
                           Foreground="{ThemeResource TextTertiaryBrush}"
                           FontFamily="Microsoft YaHei"
                           FontSize="11" />
                <TextBlock x:Name="StatusTip"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextTertiaryBrush}"
                           FontFamily="Microsoft YaHei"
                           FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
