<Window x:Class="陈叔叔工具箱.Controls.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1f1f1f"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1effffff" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="CaretBrush" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#3effffff" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Auto" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60cdff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,18,20,18">
        <TextBlock x:Name="TxtLabel"
                   Text="名称"
                   FontFamily="Microsoft YaHei" FontSize="11"
                   Foreground="#777777"
                   Margin="0,0,0,6" />

        <TextBox x:Name="TxtValue"
                 Style="{StaticResource FieldBox}"
                 MaxLength="60"
                 KeyDown="OnValueKeyDown" />

        <TextBlock x:Name="TxtHint"
                   Text=""
                   FontFamily="Microsoft YaHei" FontSize="11"
                   Foreground="#666666"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消"
                    FontFamily="Microsoft YaHei" FontSize="13"
                    Foreground="#cccccc"
                    Background="#2b2b2b"
                    BorderBrush="#3effffff" BorderThickness="1"
                    Padding="18,7"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="OnCancelClick"
                    Style="{StaticResource InlineLinkButton}" />
            <Button Content="确定"
                    FontFamily="Microsoft YaHei" FontSize="13" FontWeight="SemiBold"
                    Foreground="#ffffff"
                    Background="#4aa8d8"
                    BorderBrush="#5cb8e8" BorderThickness="1"
                    Padding="20,7"
                    Cursor="Hand"
                    IsDefault="True"
                    Click="OnOkClick"
                    Style="{StaticResource AccentButton}" />
        </StackPanel>
    </StackPanel>
</Window>
