<Window x:Class="陈叔叔工具箱.Controls.EditToolDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑工具"
        Width="440" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1f1f1f"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1effffff" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="CaretBrush" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#3effffff" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Auto" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60cdff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#777777" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 文件路径（只读） -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="文件路径" Style="{StaticResource FieldLabel}" />
            <Border Background="#14ffffff" CornerRadius="4" Padding="8,6">
                <TextBlock x:Name="TxtPath"
                           FontFamily="Consolas, Microsoft YaHei"
                           FontSize="11"
                           Foreground="#8a8a8a"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Border>
        </StackPanel>

        <!-- 名称 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="显示名称" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TxtName" Style="{StaticResource FieldBox}" MaxLength="60" />
        </StackPanel>

        <!-- 描述 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,6">
            <TextBlock Text="描述（显示在卡片上方的详情栏）" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TxtDesc"
                     Style="{StaticResource FieldBox}"
                     Height="120"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="只改名称和描述，文件位置不会变动。"
                   FontFamily="Microsoft YaHei" FontSize="11"
                   Foreground="#666666"
                   VerticalAlignment="Bottom"
                   Margin="0,6,0,10" />

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消"
                    FontFamily="Microsoft YaHei" FontSize="13"
                    Foreground="#cccccc"
                    Background="#2b2b2b"
                    BorderBrush="#3effffff" BorderThickness="1"
                    Padding="18,7"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="OnCancelClick"
                    Style="{StaticResource InlineLinkButton}" />
            <Button Content="保存"
                    FontFamily="Microsoft YaHei" FontSize="13" FontWeight="SemiBold"
                    Foreground="#ffffff"
                    Background="#4aa8d8"
                    BorderBrush="#5cb8e8" BorderThickness="1"
                    Padding="20,7"
                    Cursor="Hand"
                    Click="OnSaveClick"
                    Style="{StaticResource AccentButton}" />
        </StackPanel>
    </Grid>
</Window>
